rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Quem pode mexer no cardápio: só contas listadas em "admins" (criadas no console).
    function ehAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function corOk(c) {
      return c is string && c.matches('^#[0-9A-Fa-f]{6}$');
    }

    function visualOk(v) {
      return v is map
        && v.keys().hasOnly(['padrao', 'base', 'onda', 'pintas'])
        && v.padrao in ['ondas', 'liso', 'pintas', 'confete']
        && corOk(v.base) && corOk(v.onda) && corOk(v.pintas);
    }

    function saborValido(d) {
      return d.keys().hasOnly(['nome', 'preco', 'arte', 'foto', 'visual', 'ativo', 'ordem', 'atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
        && d.preco is number && d.preco > 0 && d.preco <= 1000
        && d.arte in ['mesclado', 'creme', 'confete', 'chocolate', 'acai', 'morango', 'maracuja', 'coco', 'limao', 'manga', 'uva', 'cafe', 'pacoca', 'personalizado']
        && (!('visual' in d) || visualOk(d.visual))
        && d.ativo is bool
        && d.ordem is number
        && (!('foto' in d) || (d.foto is string && d.foto.size() <= 400000));
    }

    // Todo mundo lê os sabores (é o cardápio público); só a admin escreve.
    match /sabores/{id} {
      allow read: if true;
      allow create, update: if ehAdmin() && saborValido(request.resource.data);
      allow delete: if ehAdmin();
    }

    // A lista de admins só muda pelo console do Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
